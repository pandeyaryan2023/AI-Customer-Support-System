# Copy this file to .env and fill in real values. NEVER commit .env.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/support_db
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Get a key from https://console.anthropic.com (Settings -> API keys).
# Used only by scripts/classify_complaint.py so far, not by the running application.
ANTHROPIC_API_KEY=sk-ant-your-key-here
